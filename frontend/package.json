    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.87.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^3.2.7"
  }
}
